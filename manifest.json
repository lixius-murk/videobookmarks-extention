{
    "name": "Bookmarks",
    "version": "0.1.0",
    "description": "Saving timestamps of youtube, google drive and yandex disc videos",
      "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
    "permissions": ["storage", "tabs"],
    "host_permissions": ["https://*.youtube.com/*", "https://disk.yandex.ru/*"],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["https://*.youtube.com/*", "https://disk.yandex.ru/*"],
        "js": ["contentScript.js"]
      }
        ],
    "web_accessible_resources": [
      {
        "resources": [
          "assets/bookmark.png",
          "assets/play.png",
          "assets/delete.png",
          "assets/save.png"
        ],
        "matches": ["https://*.youtube.com/*", "https://disk.yandex.ru/*"]
      }
    ],
    "action": {
      "default_icon": {
        "16": "assets/ext-icon.png",
        "24": "assets/ext-icon.png",
        "32": "assets/ext-icon.png"
      },
      "default_title": "Bookmarks",
      "default_popup": "popup.html"
    },
    "manifest_version": 3
}
